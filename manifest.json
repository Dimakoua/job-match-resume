{
    "manifest_version": 3,
    "name": "AI Resume Optimizer",
    "version": "1.0",
    "description": "Optimize your resume to match job descriptions for ATS.",
    "permissions": [
        "activeTab",
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "https://generativelanguage.googleapis.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icons/icons8-cv-48.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "libs/pdf.worker.min.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.linkedin.com/jobs/*",
                "*://*.indeed.com/*",
                "*://*.indeed.co.uk/*",
                "*://*.indeed.ca/*",
                "*://*.indeed.com.au/*",
                "*://*.glassdoor.com/Job/*",
                "*://*.glassdoor.com/job-listing/*",
                "*://*.glassdoor.co.uk/Job/*",
                "*://*.glassdoor.ca/Job/*"
            ],
            "js": [
                "libs/docx.min.js",
                "libs/docGenerator.js",
                "libs/calculate_ats_score/ats_scorer_bundle.js",
                "libs/floatingWidget.js",
                "content.js"
            ]
        }
    ],
    "icons": {
        "16": "icons/icons8-cv-16.png",
        "48": "icons/icons8-cv-48.png",
        "128": "icons/icons8-cv-96.png"
    }
}